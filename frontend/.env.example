# Local development default: the FastAPI backend running on your machine.
# All backend routes live under the /api prefix, so include it here.
# The app also auto-appends /api if you prefer to set a bare origin.
VITE_API_BASE_URL=http://localhost:8000/api

# Production uses https://ecosphere-ai-backend.onrender.com/api - set this
# ONLY in the Render dashboard env vars (frontend service), never in a local
# .env file. Do not bake the production URL into local development.
