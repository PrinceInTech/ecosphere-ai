# Backend configuration
DEMO_MODE=true
DATABASE_URL=sqlite+aiosqlite:///./ecosphere.db
SECRET_KEY=change-this-in-production
IBM_GRANITE_API_KEY=
IBM_GRANITE_URL=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# Allowed CORS origins - include BOTH local dev (http://localhost:*)
# and the deployed Render frontend. Production overrides are set in the
# Render dashboard, never in a local .env file.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://ecosphere-ai-frontend-got0.onrender.com

# Frontend configuration
# Local development default: backend running on your machine.
# All backend routes live under the /api prefix, so include it here.
# The app also auto-appends /api if you prefer to set a bare origin.
VITE_API_BASE_URL=http://localhost:8000/api
