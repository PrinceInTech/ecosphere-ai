# Backend configuration
DEMO_MODE=true
DATABASE_URL=sqlite+aiosqlite:///./ecosphere.db
SECRET_KEY=change-this-in-production
IBM_GRANITE_API_KEY=
IBM_GRANITE_URL=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp
CORS_ORIGINS=https://ecosphere-ai-frontend-got0.onrender.com

# Frontend configuration
# All backend routes live under the /api prefix, so include it here.
# The app also auto-appends /api if you prefer to set a bare origin.
VITE_API_BASE_URL=https://ecosphere-ai-backend.onrender.com/api
